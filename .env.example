# ============================================================================
# ARTCB-TERMINATOR — Variables d'environnement
# Copier ce fichier : cp .env.example .env
# ⚠️  Ne JAMAIS committer .env — il contient des secrets réels
# ============================================================================
# CERTIFIED_100=false | unique_human_proven=false | Mode DEBUG actif
# ============================================================================

# ── Général ─────────────────────────────────────────────────────────────────
DEBUG=true
LOG_LEVEL=DEBUG

# ── Guardian API ─────────────────────────────────────────────────────────────
# Port par défaut du backend Guardian (kyc_stream.py)
GUARDIAN_PORT=8002

# ── Frontend ─────────────────────────────────────────────────────────────────
# URL du backend Guardian depuis le frontend Vite
# En développement local : http://localhost:8002
# En production OVH2 : https://artcb.me (ou IP directe)
VITE_API_URL=http://localhost:8002

# ── LLM — IBM Bob CLI (priorité D-022) ──────────────────────────────────────
# Clé IBM Bob CLI — chemin B encodage LLM (D-008)
# NE PAS utiliser OpenRouter hackathon — BOB_API_KEY est la clé réelle
BOB_API_KEY=
BOB_API_BASE=https://api.us-east.bob.ibm.com
BOB_MODEL=ibm/granite-3-8b-instruct
BOB_TEAM_ID=
BOB_INSTANCE_ID=

# OPENROUTER_API_KEY = alias de BOB_API_KEY (même valeur si nécessaire pour compatibilité)
OPENROUTER_API_KEY=

# ── TTS — Gradium (D-009) ────────────────────────────────────────────────────
GRADIUM_API_KEY=
GRADIUM_API_URL=https://api.gradium.ai

# ── GitHub (D-011) ───────────────────────────────────────────────────────────
# Fine-grained PAT — expire 2026-11-04
# Scope : vgactech/ARTCB-TERMINATOR (contents:write)
# Générer sur : https://github.com/settings/tokens
GITHUB_TOKEN=

# ── Nœud live ARTCB ──────────────────────────────────────────────────────────
# AWS3 (UP) : http://13.38.209.25:8000 — SHA 5be65d9f6a, height ~1196
# OVH1 (152.228.144.34) = ❌ BLOQUÉ — ne jamais utiliser
# OVH2 : http://151.80.107.29:8000
# OVH4 : http://91.134.45.8:8000
ARTCB_API_URL=http://13.38.209.25:8000
ARTCB_API_KEY=
# Wallet agent cursor-cloud-agent (kid_abad2468682059ef) — générer via POST /wallet/create

# ── Doppler ──────────────────────────────────────────────────────────────────
# Token Doppler principal — coffre artcb-blockchain
# Projets : artcb-blockchain / artcb-2 (vc491276-ovh) / artcb3 (AWS) / artcb-4
# Obtenir sur : https://dashboard.doppler.com
DOPPLER_TOKEN=

# ── SSH Git — ARTCB-TERMINATOR ───────────────────────────────────────────────
# Clé SSH pour push vers git@github.com:vgactech/ARTCB-TERMINATOR.git
# Clé bob6 (SHA256:Ney) — ajoutée 6 octobre 2026
# Configurer dans ~/.ssh/config :
#   Host github.com
#     IdentityFile ~/.ssh/bob6_ed25519 (ou la clé configurée)
# Dépôt ARTCB principal : ssh -p 443 git@github.com:vgactech/artcb.git
#   Clé : artcb_deploy_ed25519

# ── AWS (D-031) ──────────────────────────────────────────────────────────────
# IAM user : node_artcb_3_agent — AdministratorAccess + EC2 + IAM
# Instance AWS3 : i-06c9404e42798ff76 (eu-west-3 t3.small)
AWS_API_KEY_AGENT_3=
AWS_API_CLI_AGENT_3=
AWS_DEFAULT_REGION=eu-west-3
AWS_INSTANCE_ID=i-06c9404e42798ff76

# ── OVH (D-029) ──────────────────────────────────────────────────────────────
# OVH1 = BLOQUÉ (152.228.144.34) — ne jamais tenter de connexion
# OVH2 : nic vc491276-ovh — projet 1fc10a3fb27d4511a8c7873cd16243f2
# OVH4 : nic xy4589-ovh — projet 926bb1d6755e4f2c98ae9db06ef44e4f (domaine artcb.me)
OVH_APPLICATION_KEY=
OVH_APPLICATION_SECRET=
OVH_CONSUMER_KEY=
OVH_ENDPOINT=ovh-eu

# ── OpenAI (D-053) ───────────────────────────────────────────────────────────
# Crédits OpenAI reçus — tester si fonctionnel
OPENAI_API_KEY=

# ── Deploy OVH2 ──────────────────────────────────────────────────────────────
# IP OVH2 : 151.80.107.29 (port 22)
# Clé SSH : SSH_PRIVATE_KEY dans Doppler artcb-2
OVH2_SERVER_IP=151.80.107.29
OVH2_SERVER_USER=ubuntu

# ── Forensic / Debug ─────────────────────────────────────────────────────────
# Répertoire des logs forensic nanoseconde (R097)
FORENSIC_LOG_DIR=./logs
